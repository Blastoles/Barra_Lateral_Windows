{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BarraLateral",
  "version": "0.2.0",
  "identifier": "com.blastoles.barralateral",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Barra Lateral",
        "label": "main",
        "url": "index.html",
        "width": 50,
        "height": 640,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
